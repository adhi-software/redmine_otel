<div class="contextual">
  <%= delete_link ob_trace_path(params[:id]) %>
</div>

<%= title [l(:label_ob_observability), ob_traces_path], @root.name %>

<div class="ob-page ob-trace-page">
<div class="ob-card ob-summary">
  <dl class="ob-stats">
    <div><dt><%= l(:label_date) %></dt><dd><%= ob_time(@started_at) %></dd></div>
    <div><dt><%= l(:label_ob_duration) %></dt><dd><%= ob_duration(@duration_us) %></dd></div>
    <% if @root.http_status %>
      <div><dt><%= l(:field_status) %></dt><dd><span class="ob-tag ob-status-<%= @root.http_status / 100 %>xx"><%= @root.http_status %></span></dd></div>
    <% end %>
    <div><dt><%= l(:label_ob_spans) %></dt><dd><%= @rows.size %></dd></div>
    <% if @log_count > 0 %>
      <div><dt><%= l(:label_ob_logs) %></dt><dd><%= link_to l(:label_ob_x_logs, count: @log_count), ob_logs_path(trace_id: params[:id], sort: 'logged_at') %></dd></div>
    <% end %>
    <div><dt><%= l(:label_ob_trace_id) %></dt><dd><code><%= params[:id] %></code></dd></div>
    <% if @root.target %><div><dt><%= l(:label_ob_path) %></dt><dd><code><%= @root.target %></code></dd></div><% end %>
  </dl>
  <% if @root.status_message %><p class="ob-error-message"><%= @root.status_message %></p><% end %>
</div>

<div class="ob-legend">
  <% { 'request' => :label_ob_request, 'sql' => :label_ob_sql,
       'http' => :label_ob_http_call, 'internal' => :label_ob_other }.each do |category, label| %>
    <span class="<%= category %>"><i class="ob-swatch"></i><%= l(label) %></span>
  <% end %>
  <span class="ob-failed"><i class="ob-swatch"></i><%= l(:label_ob_error) %></span>
  <em class="ob-legend-hint"><%= l(:text_ob_click_span) %></em>
</div>

<div class="ob-card ob-waterfall-scroll">
<div class="ob-waterfall">
  <div class="ob-row ob-head">
    <div class="ob-name"><%= l(:label_ob_span) %></div>
    <div class="ob-timeline">
      <div class="ob-track">
        <% ob_ticks(@duration_us).each do |percent, label| %>
          <span class="ob-tick" style="left: <%= percent %>%;"><%= label %></span>
        <% end %>
      </div>
    </div>
    <div class="ob-number"><%= l(:label_ob_duration) %></div>
  </div>
  <% @rows.each do |span, depth| %>
    <% hint = ob_span_hint(span) %>
    <div class="ob-row ob-span <%= span.category %> <%= 'ob-failed' if span.failed? %>"
         tabindex="0" role="button" aria-expanded="false">
      <div class="ob-name" style="padding-left: <%= 12 + depth * 14 %>px;" title="<%= [span.name, hint].compact.join(' - ') %>">
        <span class="ob-caret"></span><span class="ob-span-name"><%= span.name %></span>
        <% if hint %><span class="ob-hint"><%= hint %></span><% end %>
      </div>
      <div class="ob-timeline">
        <div class="ob-track"><div class="ob-bar" style="<%= ob_bar_style(span, @started_at, @duration_us) %>"></div></div>
      </div>
      <div class="ob-number"><%= ob_duration(span.duration_us) %></div>
    </div>
    <div class="ob-details" hidden>
      <dl class="ob-attributes">
        <dt><%= l(:field_type) %></dt><dd><%= span.kind %></dd>
        <dt><%= l(:label_ob_offset) %></dt><dd>+<%= ob_duration(((span.started_at - @started_at) * 1_000_000).round) %></dd>
        <% if span.status_message %><dt><%= l(:field_status) %></dt><dd><%= ob_value(span.status_message) %></dd><% end %>
        <% span.span_attributes.sort.each do |key, value| %>
          <dt><%= key %></dt><dd><%= ob_value(value) %></dd>
        <% end %>
      </dl>
      <% span.events.each do |event| %>
        <h4 class="ob-event"><%= event['name'] %> <span>+<%= ob_duration(event['offset_us']) %></span></h4>
        <dl class="ob-attributes">
          <% Hash(event['attributes']).sort.each do |key, value| %>
            <dt><%= key %></dt><dd><%= ob_value(value) %></dd>
          <% end %>
        </dl>
      <% end %>
    </div>
  <% end %>
</div>
</div>
</div>

<%= render 'observability/styles' %>

<style type="text/css">
  /* Span categories, checked for colour-blind contrast. */
  .ob-trace-page {
    --ob-request: #0c66e4; --ob-sql: #1d9aaa; --ob-http: #c98500; --ob-other: #8590a2;
    line-height: 1.45;
  }
  .ob-trace-page code { padding: 0; font-size: 0.95em; color: var(--ob-text); background: none; }
  .ob-card { margin-bottom: 16px; background: var(--ob-surface); border-radius: 8px; box-shadow: var(--ob-shadow); }

  .ob-summary { padding: 14px 18px; }
  .ob-stats { display: flex; flex-wrap: wrap; gap: 12px 36px; margin: 0; }
  .ob-stats dt { margin: 0 0 2px; font-size: 0.8em; font-weight: 600; color: var(--ob-text-muted); }
  .ob-stats dd { margin: 0; font-size: 1.05em; color: var(--ob-text); word-break: break-all; }
  .ob-error-message { margin: 12px 0 0; padding: 8px 12px; color: var(--ob-error); background: var(--ob-error-soft); border-radius: 6px; }

  .ob-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; margin: 0 2px 10px; font-size: 0.9em; color: var(--ob-text-subtle); }
  .ob-legend > span { white-space: nowrap; }
  .ob-legend-hint { margin-left: auto; font-style: normal; color: var(--ob-text-muted); }
  .ob-swatch { display: inline-block; width: 10px; height: 10px; margin-right: 6px; border-radius: 3px; vertical-align: -1px; background: var(--ob-other); }

  .ob-waterfall-scroll { overflow-x: auto; }
  .ob-waterfall { min-width: 640px; font-size: 13px; }
  .ob-row { display: grid; grid-template-columns: minmax(0, 36%) minmax(0, 1fr) 7em; align-items: center; min-height: 30px; border-bottom: 1px solid var(--ob-grid); }
  .ob-head { min-height: 36px; font-size: 12px; font-weight: 600; color: var(--ob-text-muted); background: var(--ob-surface-subtle); border-bottom-color: var(--ob-line); border-radius: 8px 8px 0 0; }
  .ob-head .ob-name { padding-left: 12px; }
  .ob-name { min-width: 0; padding-right: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ob-number { padding-right: 14px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: var(--ob-text-subtle); }
  .ob-timeline { position: relative; align-self: stretch; border-left: 1px solid var(--ob-grid); }
  .ob-track { position: absolute; top: 0; bottom: 0; left: 12px; right: 12px;
                         background-image: linear-gradient(to right, var(--ob-grid) 1px, transparent 1px); background-size: 25% 100%; }
  .ob-head .ob-track { background: none; }
  .ob-tick { position: absolute; top: 50%; transform: translate(-50%, -50%); white-space: nowrap; font-weight: normal; font-variant-numeric: tabular-nums; }
  .ob-tick:first-child { transform: translate(0, -50%); }
  .ob-tick:last-child { transform: translate(-100%, -50%); }

  .ob-span { cursor: pointer; }
  .ob-span:hover, .ob-span:focus-visible { background: var(--ob-surface-subtle); outline: none; }
  .ob-span.is-open { background: var(--ob-accent-soft); border-bottom-color: transparent; }
  .ob-caret { display: inline-block; width: 0; height: 0; margin-right: 8px; vertical-align: 1px; border-style: solid; border-width: 4px 0 4px 5px; border-color: transparent transparent transparent var(--ob-text-muted); transition: transform 0.15s; }
  .ob-span.is-open .ob-caret { transform: rotate(90deg); }
  .ob-span-name { color: var(--ob-text); }
  .ob-hint { margin-left: 8px; font-family: monospace; font-size: 12px; color: var(--ob-text-muted); }
  .ob-bar { position: absolute; top: 50%; height: 10px; margin-top: -5px; border-radius: 3px; background: var(--ob-other); }
  .request .ob-bar, .request .ob-swatch { background: var(--ob-request); }
  .sql .ob-bar, .sql .ob-swatch { background: var(--ob-sql); }
  .http .ob-bar, .http .ob-swatch { background: var(--ob-http); }
  .ob-failed .ob-bar, .ob-failed .ob-swatch { background: var(--ob-error); }
  .ob-failed .ob-span-name { color: var(--ob-error); }

  .ob-details { padding: 6px 16px 12px 34px; background: var(--ob-surface-subtle); border-bottom: 1px solid var(--ob-line); }
  .ob-attributes pre { margin: 0; padding: 6px 8px; font-size: 12px; line-height: 1.5; white-space: pre-wrap; background: var(--ob-surface); border: 1px solid var(--ob-line); border-radius: 4px; }
  .ob-event { margin: 12px 0 2px; font-size: 13px; color: var(--ob-text); }
  .ob-event span { margin-left: 4px; font-weight: normal; color: var(--ob-text-muted); }
</style>

<%= javascript_tag do %>
  $(function () {
    $('.ob-waterfall').on('click keydown', '.ob-span', function (event) {
      if (event.type === 'keydown') {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
      }
      var open = $(this).toggleClass('is-open').hasClass('is-open');
      $(this).attr('aria-expanded', open).next('.ob-details').prop('hidden', !open);
    });
  });
<% end %>
