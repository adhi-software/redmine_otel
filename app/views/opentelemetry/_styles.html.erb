<style type="text/css">
  .ot-page {
    --ot-accent: #0c66e4; --ot-accent-hover: #0055cc; --ot-accent-soft: #e9f2ff;
    --ot-error: #c9372c; --ot-error-hover: #ae2e24; --ot-error-soft: #ffeceb;
    --ot-success: #22a06b; --ot-success-text: #216e4e; --ot-success-soft: #dcfff1;
    --ot-warning: #e2b203; --ot-warning-text: #a54800; --ot-warning-soft: #fff7d6;
    --ot-text: #172b4d; --ot-text-subtle: #44546f; --ot-text-muted: #6b778c;
    --ot-line: #dcdfe4; --ot-grid: #f1f2f4; --ot-surface: #ffffff; --ot-surface-subtle: #f7f8f9;
    --ot-shadow: 0 1px 1px rgba(9, 30, 66, 0.13), 0 0 1px rgba(9, 30, 66, 0.2);
    color: var(--ot-text);
  }
  .ot-filters { margin-bottom: 16px; }
  .ot-filter { display: inline-block; margin: 2px 14px 2px 0; white-space: nowrap; }
  .ot-filter-chip a { margin-left: 4px; color: inherit; }

  .ot-chart { margin-bottom: 16px; padding: 12px 16px 8px; background: var(--ot-surface); border-radius: 8px; box-shadow: var(--ot-shadow); }
  .ot-chart-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; margin-bottom: 8px; }
  .ot-chart-head strong { margin-right: 8px; color: var(--ot-text); }
  .ot-chart-note { font-size: 0.85em; color: var(--ot-text-muted); }
  .ot-chart-plot { position: relative; height: 180px; }

  .ot-results-header { display: flex; align-items: center; gap: 16px; margin-bottom: 10px; color: var(--ot-text-subtle); }
  .ot-results-header strong { margin-right: auto; font-size: 1.2em; color: var(--ot-text); }
  .ot-results-header a.ot-delete { flex: none; color: var(--ot-text-subtle); }
  .ot-results-header a.ot-delete:hover { color: var(--ot-error); text-decoration: none; }

  .ot-tag { display: inline-block; padding: 0 8px; line-height: 20px; font-size: 0.85em; font-weight: 600; white-space: nowrap; color: var(--ot-text-subtle); background: var(--ot-grid); border-radius: 10px; }
  .ot-tag-error { color: var(--ot-error); background: var(--ot-error-soft); }
  .ot-status-2xx, .ot-status-3xx { color: var(--ot-success-text); background: var(--ot-success-soft); }
  .ot-status-4xx { color: var(--ot-warning-text); background: var(--ot-warning-soft); }
  .ot-status-5xx { color: var(--ot-error); background: var(--ot-error-soft); }
  .ot-divider { margin: 0 6px; color: var(--ot-line); }
  .ot-ago { margin-left: 8px; color: var(--ot-text-muted); font-size: 0.9em; }

  .ot-attributes { display: grid; grid-template-columns: minmax(140px, 26%) minmax(0, 1fr); margin: 0; }
  .ot-attributes dt, .ot-attributes dd { margin: 0; padding: 5px 0; border-bottom: 1px solid var(--ot-line); }
  .ot-attributes dt { padding-right: 16px; color: var(--ot-text-muted); word-break: break-all; }
  .ot-attributes dd { color: var(--ot-text); overflow-wrap: anywhere; }
  .ot-attributes dt:nth-last-of-type(1), .ot-attributes dd:last-child { border-bottom: 0; }
</style>
