<span class="ot-filter">
  <label for="period"><%= l(:label_ot_period) %>:</label>
  <%= select_tag 'period', ot_period_options(period) %>
</span>
<% custom = period == 'custom' %>
<span id="ot-custom-range" style="<%= 'display: none;' unless custom %>">
  <span class="ot-filter">
    <label for="from"><%= l(:label_ot_from) %>:</label>
    <%= date_field_tag 'from', params[:from], disabled: !custom %><%= calendar_for('from') %>
  </span>
  <span class="ot-filter">
    <label for="to"><%= l(:label_ot_to) %>:</label>
    <%= date_field_tag 'to', params[:to], disabled: !custom %><%= calendar_for('to') %>
  </span>
</span>

<%= javascript_tag do %>
  $(function () {
    $('#period').on('change', function () {
      var custom = this.value === 'custom';
      $('#ot-custom-range').toggle(custom).find('input').prop('disabled', !custom);
    });
  });
<% end %>
