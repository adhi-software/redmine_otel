<%= render 'opentelemetry/header', tab: 'metrics' %>

<%= form_tag(ot_metrics_path, method: :get, id: 'ot-search') do %>
<fieldset class="ot-filters"><legend><%= l(:label_filter_plural) %></legend>
  <span class="ot-filter">
    <label for="name"><%= l(:label_ot_metric) %>:</label>
    <%= select_tag 'name', options_for_select(@names, @name), onchange: "$('#series').remove(); this.form.submit();" %>
  </span>
  <%= render 'opentelemetry/period_filter', period: @period %>
  <% if params[:series].present? %>
    <span class="ot-filter">
      <%= hidden_field_tag 'series', params[:series] %>
      <span class="ot-tag ot-filter-chip" title="<%= params[:series] %>">
        <%= l(:label_ot_series) %>: <%= OtMetric.labels(params[:series]).values.join(' · ').truncate(80) %>
        <%= link_to '×', ot_metrics_path(filter_params.except('series')), title: l(:button_clear), 'aria-label': l(:button_clear) %>
      </span>
    </span>
  <% end %>
  <span class="ot-filter">
    <%= submit_tag l(:button_apply), class: 'small', name: nil %>
    <%= link_to sprite_icon('reload', l(:button_clear)), ot_metrics_path, class: 'icon icon-reload' %>
  </span>
</fieldset>
<% end %>

<div class="ot-page">
<% if @summary.nil? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <% unit = @latest.unit %>
  <% stats = ot_metric_stats(@summary, @shape, unit) %>
  <div class="ot-chart">
    <div class="ot-chart-head">
      <div>
        <strong><%= @name %></strong>
        <span class="ot-chart-note"><%= [@latest.description, l(:text_ot_bucket, value: ot_bucket_label(@bucket_size))].compact.join(' · ') %></span>
      </div>
    </div>
    <dl class="ot-metric-stats">
      <% stats.each do |label, value| %>
        <div><dt><%= label %></dt><dd><%= value %></dd></div>
      <% end %>
    </dl>
    <div class="ot-chart-plot ot-metric-plot">
      <%= content_tag :canvas, '', id: 'ot-metric-chart', role: 'img', 'aria-label': @name,
                      data: { points: @points.to_json, shape: @shape, unit: unit, zone: ot_zone_name, labels: ot_chart_labels.to_json } %>
    </div>
  </div>

  <div class="ot-results-header">
    <strong><%= l(:label_ot_x_series, count: @series_count) %></strong>
    <%= delete_link ot_metrics_path(filter_params), { class: 'icon icon-del ot-delete',
                    data: { confirm: l(:text_ot_delete_metric) } }, l(:label_ot_delete_all) %>
  </div>
  <div class="autoscroll">
    <table class="list ot-series">
      <thead>
        <tr>
          <th class="ot-series-name"><%= l(:label_ot_series) %></th>
          <% stats.each do |label, _| %><th class="ot-number"><%= label %></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% @series.each do |series, summary| %>
          <tr class="<%= 'ot-selected' if series == params[:series] %>">
            <td class="ot-series-name">
              <%= link_to ot_series_labels(series), ot_metrics_path(filter_params.merge('series' => series)), title: l(:text_ot_click_series) %>
            </td>
            <% ot_metric_stats(summary, @shape, unit).each do |_, value| %><td class="ot-number"><%= value %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
</div>

<style type="text/css">
  .ot-metric-stats { display: flex; flex-wrap: wrap; gap: 8px 32px; margin: 4px 0 12px; }
  .ot-metric-stats dt { margin: 0 0 2px; font-size: 0.8em; font-weight: 600; color: var(--ot-text-muted); }
  .ot-metric-stats dd { margin: 0; font-size: 1.3em; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ot-text); }
  .ot-chart-plot.ot-metric-plot { height: 240px; }
  table.ot-series th.ot-series-name, table.ot-series td.ot-series-name { text-align: left; }
  table.ot-series .ot-number { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  table.ot-series tr.ot-selected td { background: var(--ot-accent-soft); }
  table.ot-series a:hover { text-decoration: none; }
  table.ot-series a:hover .ot-label { box-shadow: inset 0 0 0 1px var(--ot-accent); }
  .ot-label { display: inline-block; margin: 1px 6px 1px 0; padding: 0 6px; line-height: 20px; border-radius: 4px; white-space: nowrap; color: var(--ot-text); background: var(--ot-grid); }
  .ot-label-key { margin-right: 4px; font-size: 0.85em; color: var(--ot-text-muted); }
  .ot-label.ot-status-2xx, .ot-label.ot-status-3xx { color: var(--ot-success-text); background: var(--ot-success-soft); }
  .ot-label.ot-status-4xx { color: var(--ot-warning-text); background: var(--ot-warning-soft); }
  .ot-label.ot-status-5xx { color: var(--ot-error); background: var(--ot-error-soft); }
</style>

<%= javascript_tag type: 'module' do %>
  const canvas = document.getElementById('ot-metric-chart');
  if (canvas) import('chart.js').then(({ default: Chart }) => {
    const points = JSON.parse(canvas.dataset.points);
    const labels = JSON.parse(canvas.dataset.labels);
    const { shape, unit } = canvas.dataset;
    const style = getComputedStyle(canvas);
    const color = (name) => style.getPropertyValue(name).trim();
    const xs = points.map((p) => p.x);
    const lang = document.documentElement.lang || undefined;
    const clock = { timeZone: canvas.dataset.zone || undefined, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' };
    const day = { month: 'short', day: 'numeric' };
    const tick = new Intl.DateTimeFormat(lang, xs[xs.length - 1] - xs[0] < 86400000 ? clock : Object.assign({}, clock, day));
    const fullTime = new Intl.DateTimeFormat(lang, Object.assign({}, clock, day));
    const duration = (ms) => ms === 0 ? '0' : ms >= 1000 ? `${+(ms / 1000).toFixed(2)} s` : `${+ms.toFixed(ms < 10 ? 2 : 1)} ms`;
    const bytes = (b) => b >= 1073741824 ? `${+(b / 1073741824).toFixed(2)} GB` : b >= 1048576 ? `${+(b / 1048576).toFixed(1)} MB` : `${+(b / 1024).toFixed(1)} KB`;
    const format = (v) => v == null ? '' : unit === 's' ? duration(v * 1000) : unit === 'ms' ? duration(v)
      : unit === 'By' ? bytes(v) : (+v.toFixed(2)).toLocaleString(lang);
    const line = (key, name, dashed) => ({
      type: 'line', label: labels[key], data: points.map((p) => p[key]), yAxisID: 'y', order: 1,
      borderColor: color(name), backgroundColor: color(name), borderWidth: 2, borderDash: dashed ? [4, 3] : [],
      pointStyle: 'line', pointRadius: 0, pointHitRadius: 6, tension: 0.2, spanGaps: false
    });
    const bar = (key, name, axis) => ({
      type: 'bar', label: labels[key], data: points.map((p) => p[key]), yAxisID: axis, order: 2,
      backgroundColor: color(name), hoverBackgroundColor: color(name), pointStyle: 'rect', barPercentage: 1, categoryPercentage: 0.9
    });
    const datasets = shape === 'histogram' ? [line('average', '--ot-accent'), line('max', '--ot-warning-text', true), bar('count', '--ot-accent-soft', 'count')]
      : shape === 'sum' ? [bar('total', '--ot-accent', 'y')]
      : [line('average', '--ot-accent'), line('max', '--ot-warning-text', true)];
    const scales = {
      x: { grid: { display: false }, border: { color: color('--ot-line') },
           ticks: { maxTicksLimit: 8, maxRotation: 0, autoSkipPadding: 12, callback: (value) => tick.format(xs[value]) } },
      y: { beginAtZero: true, grace: '10%', border: { display: false }, grid: { color: color('--ot-grid'), drawTicks: false },
           ticks: { maxTicksLimit: 5, padding: 8, callback: format } }
    };
    if (shape === 'histogram') {
      scales.count = { position: 'right', beginAtZero: true, grace: '10%', border: { display: false }, grid: { display: false },
                       ticks: { maxTicksLimit: 5, precision: 0 } };
    }
    Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
    Chart.defaults.color = color('--ot-text-muted');

    new Chart(canvas, {
      type: 'bar',
      data: { labels: xs, datasets },
      options: {
        maintainAspectRatio: false,
        animation: { duration: 250 },
        interaction: { mode: 'index', intersect: false },
        scales,
        plugins: {
          legend: { position: 'bottom', align: 'end', labels: { usePointStyle: true, boxWidth: 18, boxHeight: 10 } },
          tooltip: {
            backgroundColor: color('--ot-text'), titleColor: '#fff', bodyColor: color('--ot-line'),
            padding: 10, cornerRadius: 6, caretSize: 5, boxPadding: 4,
            filter: (item) => item.raw != null,
            callbacks: {
              title: (items) => fullTime.format(xs[items[0].dataIndex]),
              label: (item) => `${item.dataset.label}: ${item.dataset.yAxisID === 'count' ? item.raw.toLocaleString(lang) : format(item.raw)}`
            }
          }
        }
      }
    });
  });
<% end %>
