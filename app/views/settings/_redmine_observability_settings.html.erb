<%
  destinations = RedmineObservability::Destinations
  viewers = RedmineObservability::Viewers
  # Each option's value is the full saved row, so it round-trips on save; the
  # text hides the headers, which usually hold an API key.
  destination_options = Array(settings['destinations']).reject(&:blank?).map do |text|
    row = destinations::Row.parse(text)
    label = [destinations.label(row.type), row.endpoint].join('  |  ')
    label += '  |  ****' if row.headers.present?
    [label, text]
  end
  recorded_types = destination_options.map { |_, text| destinations::Row.parse(text).type }
  hosted = Array(settings['hosted_viewers']).filter_map { viewers::ALL[_1] }
%>

<% unless RedmineObservability.pipeline %>
  <div class="flash warning"><%= l(:text_observability_not_loaded) %></div>
<% end %>

<fieldset>
  <legend><%= l(:label_observability_recording) %></legend>
  <p>
    <label for="settings_destinations"><%= l(:label_observability_destinations) %></label>
    <%# Posted even when every row is deleted, so removing the last one sticks. %>
    <%= hidden_field_tag 'settings[destinations][]', '', id: nil %>
    <%= select_tag 'settings[destinations][]', options_for_select(destination_options),
          multiple: true, size: 6, id: 'settings_destinations', class: 'observability-list' %>
    <em class="info"><%= l(:text_observability_destinations) %></em>
  </p>
  <p>
    <%= link_to l(:button_add), '#', class: 'button', data: { destination_action: 'add' } %> |
    <%= link_to l(:button_edit), '#', class: 'button', data: { destination_action: 'edit' } %> |
    <%= link_to l(:button_delete), '#', class: 'button', data: { destination_action: 'delete' } %>
  </p>
</fieldset>

<fieldset>
  <legend><%= l(:label_observability_hosting) %></legend>
  <p>
    <label for="settings_hosted_viewers"><%= l(:label_observability_viewers) %></label>
    <%= hidden_field_tag 'settings[hosted_viewers][]', '', id: nil %>
    <%= select_tag 'settings[hosted_viewers][]',
          options_for_select(viewers::ALL.values.map { [_1.label, _1.key] }, hosted.map(&:key)),
          multiple: true, size: viewers::ALL.size, id: 'settings_hosted_viewers', class: 'observability-list' %>
    <em class="info"><%= l(:text_observability_viewers) %></em>
  </p>

  <% if hosted.any? %>
    <table class="list observability-viewers">
      <thead>
        <tr>
          <th><%= l(:label_observability_viewer) %></th>
          <th><%= l(:field_status) %></th>
          <th><%= l(:label_observability_receives_at) %></th>
          <th><%= l(:label_observability_login) %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% hosted.each do |viewer| %>
          <% status = viewers.status(viewer) %>
          <tr>
            <td><%= link_to viewer.label, "http://#{request.host}:#{viewer.ui_port}", target: '_blank', rel: 'noopener' %></td>
            <td><%= l(:"label_observability_#{status}") %></td>
            <td>
              <code><%= viewer.receives %></code>
              <% unless recorded_types.include?(viewer.key) %>
                <em class="info"><%= l(:text_observability_not_recorded) %></em>
              <% end %>
            </td>
            <td>
              <% if viewer.key == 'openobserve' %>
                <%= viewers.openobserve_login.join(' / ') %>
              <% elsif viewer.key == 'grafana-tempo' %>
                <%= l(:text_observability_grafana_login) %>
              <% end %>
            </td>
            <td class="buttons">
              <% if status == :stopped %>
                <%= link_to l(:button_observability_start), start_observability_viewer_path(viewer.key), method: :post %>
              <% elsif status == :running %>
                <%= link_to l(:button_observability_stop), stop_observability_viewer_path(viewer.key), method: :post %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</fieldset>

<%# Moved out of the form by jQuery UI, so these fields are never posted. %>
<div id="observability-destination-dlg" title="<%= l(:label_observability_destination) %>" style="display:none;">
  <table class="observability-dialog">
    <tr>
      <th><label for="observability_type"><%= l(:field_type) %></label></th>
      <td>
        <%= select_tag 'observability_type',
              options_for_select(destinations.types.map { |type|
                [type.label, type.key, { 'data-endpoint' => type.endpoint, 'data-headers' => type.headers }]
              }), name: nil %>
      </td>
    </tr>
    <tr>
      <th><label for="observability_endpoint"><%= l(:label_observability_endpoint) %></label></th>
      <td><%= text_field_tag 'observability_endpoint', '', name: nil %></td>
    </tr>
    <tr>
      <th><label for="observability_headers"><%= l(:label_observability_headers) %></label></th>
      <td>
        <%= text_field_tag 'observability_headers', '', name: nil, autocomplete: 'off' %>
        <em class="info"><%= l(:text_observability_headers) %></em>
      </td>
    </tr>
  </table>
</div>

<style type="text/css">
  .observability-list { min-width: 420px; max-width: 100%; }
  table.observability-viewers td { text-align: left; }
  table.observability-dialog { width: 100%; border-spacing: 8px 10px; }
  table.observability-dialog th { text-align: left; white-space: nowrap; width: 80px; vertical-align: top; }
  table.observability-dialog input, table.observability-dialog select { width: 100%; box-sizing: border-box; }
</style>

<script type="text/javascript">
//<![CDATA[
$(function () {
  var list = $('#settings_destinations');
  var dialog = $('#observability-destination-dlg');
  var type = $('#observability_type');
  var endpoint = $('#observability_endpoint');
  var headers = $('#observability_headers');
  // The option being edited; null while adding.
  var editing = null;

  function applyDefaults() {
    var option = type.find('option:selected');
    endpoint.val(option.attr('data-endpoint'));
    headers.val(option.attr('data-headers'));
  }

  function save() {
    var url = String(endpoint.val()).trim();
    var extra = String(headers.val()).trim();
    if (!/^https?:\/\/\S+$/.test(url)) {
      alert("<%= escape_javascript(l(:text_observability_invalid_endpoint)) %>");
      return;
    }
    var option = editing || $('<option>').appendTo(list);
    option.val([type.val(), url, extra].join('|'));
    option.text(type.find('option:selected').text() + '  |  ' + url + (extra ? '  |  ****' : ''));
    dialog.dialog('close');
  }

  dialog.dialog({
    autoOpen: false, modal: true, width: 560,
    buttons: [
      { text: "<%= escape_javascript(l(:button_save)) %>", click: save },
      { text: "<%= escape_javascript(l(:button_cancel)) %>", click: function () { dialog.dialog('close'); } }
    ]
  });
  type.on('change', applyDefaults);

  $('[data-destination-action]').on('click', function (event) {
    event.preventDefault();
    var action = $(this).attr('data-destination-action');
    var selected = list.find('option:selected');
    if (action === 'add') {
      editing = null;
      type.prop('selectedIndex', 0);
      applyDefaults();
      dialog.dialog('open');
    } else if (!selected.length) {
      alert("<%= escape_javascript(l(:text_observability_select_row)) %>");
    } else if (action === 'edit') {
      editing = selected.first();
      var parts = editing.val().split('|');
      type.val(parts[0]);
      endpoint.val(parts[1] || '');
      headers.val(parts.slice(2).join('|'));
      dialog.dialog('open');
    } else if (confirm("<%= escape_javascript(l(:text_are_you_sure)) %>")) {
      selected.remove();
    }
  });

  // A multi-select posts only selected options, so select every row on save.
  list.closest('form').on('submit', function () {
    list.find('option').prop('selected', true);
  });
});
//]]>
</script>
