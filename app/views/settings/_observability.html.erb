<%
  destinations = RedmineObservability::Destinations
  # Value is the row as JSON, so older rows are converted on save; the text hides the headers, which hold API keys.
  destination_options = Array(settings['destinations']).reject(&:blank?).map do |text|
    row = destinations::Row.parse(text)
    label = [row.name.presence, destinations.label(row.format), row.endpoint].compact.join('  |  ')
    label += '  |  ****' if row.headers.present?
    [label, row.to_h.to_json]
  end
%>

<% unless RedmineObservability.pipeline %>
  <div class="flash warning"><%= l(:text_observability_not_loaded) %></div>
<% end %>

<fieldset>
  <legend><%= l(:label_observability_recording) %></legend>
  <p>
    <label for="settings_destinations"><%= l(:label_observability_destinations) %></label>
    <%# Lets an empty list be saved. %>
    <%= hidden_field_tag 'settings[destinations][]', '', id: nil %>
    <%= select_tag 'settings[destinations][]', options_for_select(destination_options),
          multiple: true, size: 6, id: 'settings_destinations', class: 'observability-destinations multi-row' %>
    <em class="info"><%= l(:text_observability_destinations) %></em>
  </p>
  <p>
    <%= link_to l(:button_add), '#', class: 'button', data: { destination_action: 'add' } %> |
    <%= link_to l(:button_edit), '#', class: 'button', data: { destination_action: 'edit' } %> |
    <%= link_to l(:button_delete), '#', class: 'button', data: { destination_action: 'delete' } %>
  </p>
</fieldset>

<%# Moved out of the form by jQuery UI, so these fields are never posted. %>
<div id="observability-destination-dlg" title="<%= l(:label_observability_destination) %>" style="display:none;">
  <table class="observability-dialog">
    <tr>
      <th><label for="observability_name"><%= l(:field_name) %></label></th>
      <td><%= text_field_tag 'observability_name', '', name: nil %></td>
    </tr>
    <tr>
      <th><label for="observability_format"><%= l(:label_observability_format) %></label></th>
      <td>
        <%= select_tag 'observability_format',
              options_for_select(destinations.formats.map { |format|
                [format.label, format.key, { 'data-endpoint' => format.endpoint }]
              }), name: nil %>
      </td>
    </tr>
    <tr>
      <th><label for="observability_endpoint"><%= l(:label_observability_endpoint) %></label></th>
      <td><%= text_field_tag 'observability_endpoint', '', name: nil %></td>
    </tr>
    <tr>
      <th><label for="observability_headers"><%= l(:label_observability_headers) %></label></th>
      <td>
        <%= text_field_tag 'observability_headers', '', name: nil, autocomplete: 'off' %>
        <em class="info"><%= l(:text_observability_headers) %></em>
      </td>
    </tr>
  </table>
</div>

<style type="text/css">
  .observability-destinations { min-width: 420px; max-width: 100%; }
  table.observability-dialog { width: 100%; border-spacing: 8px 10px; }
  table.observability-dialog th { text-align: left; white-space: nowrap; width: 80px; vertical-align: top; }
  table.observability-dialog input, table.observability-dialog select { width: 100%; box-sizing: border-box; }
</style>

<script type="text/javascript">
//<![CDATA[
$(function () {
  var list = $('#settings_destinations');
  var dialog = $('#observability-destination-dlg');
  var name = $('#observability_name');
  var format = $('#observability_format');
  var endpoint = $('#observability_endpoint');
  var headers = $('#observability_headers');
  // The option being edited; null while adding.
  var editing = null;

  // Shows the format's usual endpoint without overwriting what was typed.
  function showExample() {
    endpoint.attr('placeholder', format.find('option:selected').attr('data-endpoint'));
  }

  function save() {
    var row = {
      name: String(name.val()).trim(),
      format: format.val(),
      endpoint: String(endpoint.val()).trim(),
      headers: String(headers.val()).trim()
    };
    if (!/^https?:\/\/\S+$/.test(row.endpoint)) {
      alert("<%= escape_javascript(l(:text_observability_invalid_endpoint)) %>");
      return;
    }
    var label = [row.name, format.find('option:selected').text(), row.endpoint].filter(Boolean).join('  |  ');
    var option = editing || $('<option>').appendTo(list);
    option.val(JSON.stringify(row));
    option.text(label + (row.headers ? '  |  ****' : ''));
    dialog.dialog('close');
  }

  dialog.dialog({
    autoOpen: false, modal: true, width: 560,
    buttons: [
      { text: "<%= escape_javascript(l(:button_save)) %>", click: save },
      { text: "<%= escape_javascript(l(:button_cancel)) %>", click: function () { dialog.dialog('close'); } }
    ]
  });
  format.on('change', showExample);

  $('[data-destination-action]').on('click', function (event) {
    event.preventDefault();
    var action = $(this).attr('data-destination-action');
    var selected = list.find('option:selected');
    if (action === 'add') {
      editing = null;
      name.val('');
      format.prop('selectedIndex', 0);
      endpoint.val('');
      headers.val('');
      showExample();
      dialog.dialog('open');
    } else if (!selected.length) {
      alert("<%= escape_javascript(l(:text_observability_select_row)) %>");
    } else if (action === 'edit') {
      editing = selected.first();
      var row = JSON.parse(editing.val());
      name.val(row.name);
      format.val(row.format);
      endpoint.val(row.endpoint);
      headers.val(row.headers);
      showExample();
      dialog.dialog('open');
    } else if (confirm("<%= escape_javascript(l(:text_are_you_sure)) %>")) {
      selected.remove();
    }
  });

  // Only selected options are posted, so select every row on save.
  list.closest('form').on('submit', function () {
    list.find('option').prop('selected', true);
  });
});
//]]>
</script>
